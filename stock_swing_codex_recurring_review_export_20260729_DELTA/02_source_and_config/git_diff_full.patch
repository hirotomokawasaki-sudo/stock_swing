+  - threshold_pct: -8.0   # return > -8%:  中間域      → 3日様子見
+    min_hold_days: 3
+  # return <= -8%: 真の止損域 → base min_hold_days (1日) で素早く exit
diff --git a/scripts/analyze_stop_loss_post_exit.py b/scripts/analyze_stop_loss_post_exit.py
