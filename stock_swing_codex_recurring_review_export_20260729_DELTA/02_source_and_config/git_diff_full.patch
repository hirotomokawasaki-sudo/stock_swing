+        # trade_id encodes first 8 chars of decision_id
+        prefix8 = decision_id[:8]  # "abcd1234"
+        self._write_events(events_file, [
+            {
+                "event_type": "trade_opened",
+                "broker_order_id": "broker-aapl-1",
