+    assert first!=second
+    assert load_capture(tmp_path,second)['payload']['candidates']==[]
+
+
+@pytest.mark.parametrize('changes',[
+    {'run_id':'../../escape'}, {'run_id':''}, {'stage':'invented'},
+    {'observed_at':datetime(2026,10,21)}, {'signals':None},
